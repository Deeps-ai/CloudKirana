import argparse
import json
from app.inspection import run_inspection
from app.models import InspectionParameters
import cv2

if __name__ == "__main__":
    parser = argparse.ArgumentParser()
    parser.add_argument("--image", required=True)
    parser.add_argument("--pixels_per_mm", type=float, default=None, help="Pixels per millimetre for physical scale conversion")
    parser.add_argument("--pdp_area_cm2", type=float, default=None, help="Principal Display Panel area in square centimetres")
    parser.add_argument("--print_type", type=str, default="normal", choices=["normal", "blown_formed_moulded_embossed"])
    args = parser.parse_args()

    params = InspectionParameters(
        pdp_area_cm2=args.pdp_area_cm2,
        pixels_per_mm=args.pixels_per_mm,
        print_type=args.print_type
    )

    image = cv2.imread(args.image)
    if image is None:
        raise FileNotFoundError(f"Could not read image: {args.image}")

    response = run_inspection(image, params)

    if not response.success:
        print(f"Error: {response.error}")
    else:
        print(json.dumps(response.inspection.model_dump(), indent=4))

